{
  "name": "react-native-app-functions",
  "version": "0.2.0-alpha.0",
  "description": "Expose React Native app functionality to on-device AI agents (Gemini and others) through Android AppFunctions, declared from TypeScript.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-app-functions-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./config": {
      "react-native-app-functions-source": "./src/config.ts",
      "types": "./lib/typescript/src/config.d.ts",
      "default": "./lib/module/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "codegen/lib",
    "versions.json",
    "CHANGELOG.md",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-app-functions-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && tsc -p codegen/tsconfig.json",
    "typecheck": "tsc && tsc -p codegen/tsconfig.check.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "android",
    "appfunctions",
    "app-functions",
    "ai",
    "agents",
    "ai-agents",
    "gemini",
    "llm",
    "mcp",
    "tools",
    "headless-js",
    "kotlin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvinotuya84/react-native-app-functions.git"
  },
  "author": "Alvin Otuya <otuyaalvin@gmail.com> (https://github.com/Alvinotuya84)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alvinotuya84/react-native-app-functions/issues"
  },
  "homepage": "https://github.com/Alvinotuya84/react-native-app-functions#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.10.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">= 22.13"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AppFunctionsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.alvinotuya.appfunctions"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/codegen"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/codegen/lib/",
      "<rootDir>/examples/"
    ]
  }
}
